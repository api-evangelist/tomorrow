                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events?location=<string>&insights=<string>&insights=<string>&buffer=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ],
              "query": [
                {
                  "description": "(Required) ",
                  "key": "location",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Comma-separated insight IDs or pre-defined category names.",
                  "key": "insights",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Comma-separated insight IDs or pre-defined category names.",
                  "key": "insights",
                  "value": "<string>"
                },
                {
                  "description": "Radius around the location in kilometers.",
                  "key": "buffer",
                  "value": "1"
                }
              ]
            },
            "description": "Returns events matching the supplied insights at a location, optionally with a kilometer-radius buffer."
