  "info": {
    "_postman_id": "4c407e1d-81bc-43d8-9637-ea5a9a6db1d1",
    "name": "Tomorrow.io Weather Alerts Events API",
    "description": "Unified Tomorrow.io v4 HTTP API for weather and climate intelligence. Combines realtime observations, forecast timelines (minutely, hourly, daily, current), historical data up to 20 years, weather along a route, raster map tiles, plus management surfaces for Locations, Insights, Alerts, and Events.\n\nContact Support:\n Name: Tomorrow.io Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T03:17:17.000Z",
    "updatedAt": "2026-07-28T03:17:17.000Z",
