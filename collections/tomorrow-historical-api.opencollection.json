{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tomorrow.io Weather Alerts Historical API",
    "version": "4.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Historical",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tomorrow.io Post Historical Timeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tomorrow.io/v4/historical",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns historical weather timelines for a location, up to 20 years back."
        }
      ]
    }
  ],
  "bundled": true
}