{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tomorrow.io Weather Alerts Climate API",
    "version": "4.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Climate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tomorrow.io Post Climate Normals",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tomorrow.io/v4/historical/normals",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns 30-year monthly climate normals for a location."
        }
      ]
    }
  ],
  "bundled": true
}